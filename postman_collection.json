{
  "info": {
    "name": "Healthcare Backend API",
    "description": "Django + DRF + PostgreSQL healthcare backend.\n\nRun the requests top to bottom: Register and Login store the JWT and the created ids in collection variables, so nothing needs to be copied by hand.\n\nSet `base_url` if the server is not on http://127.0.0.1:8000.\n\nInteractive docs are also served by the app itself at /api/docs/ (Swagger UI) and /api/redoc/, generated from the code.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "patient_id",
      "value": ""
    },
    {
      "key": "doctor_id",
      "value": ""
    },
    {
      "key": "mapping_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates an account and returns the user plus a JWT pair.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Disha Gupta\",\n  \"email\": \"disha@example.com\",\n  \"password\": \"StrongPass!234\",\n  \"confirm_password\": \"StrongPass!234\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('request succeeded', () => pm.expect(body.success).to.be.true);",
                  "if (body.data && body.data.tokens) {",
                  "    pm.collectionVariables.set('access_token', body.data.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', body.data.tokens.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Exchanges credentials for a JWT pair; stores the tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"disha@example.com\",\n  \"password\": \"StrongPass!234\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('request succeeded', () => pm.expect(body.success).to.be.true);",
                  "if (body.data && body.data.tokens) {",
                  "    pm.collectionVariables.set('access_token', body.data.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', body.data.tokens.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Returns a fresh access token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('has access token', () => pm.expect(body).to.have.property('access'));",
                  "pm.collectionVariables.set('access_token', body.access);",
                  "if (body.refresh) pm.collectionVariables.set('refresh_token', body.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/profile/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "profile"
              ]
            },
            "description": "The authenticated user's own record."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('request succeeded', () => pm.expect(pm.response.json().success).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Identical to the unknown-email response, by design.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"disha@example.com\",\n  \"password\": \"WrongPassword!1\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('request rejected', () => pm.expect(pm.response.json().success).to.be.false);"
                ]
              }
            }
          ]
        }
      ]
    },
