# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY='replace-me'
DJANGO_DEBUG='True'
DJANGO_ALLOWED_HOSTS='localhost,127.0.0.1'
DJANGO_TIME_ZONE='UTC'
DJANGO_LOG_LEVEL='INFO'

# PostgreSQL
POSTGRES_DB='hospital_management'
POSTGRES_USER='hospital_admin'
POSTGRES_PASSWORD='replace-me'
POSTGRES_HOST='localhost'
POSTGRES_PORT='5432'
POSTGRES_CONN_MAX_AGE='60'

# JWT (falls back to DJANGO_SECRET_KEY when JWT_SIGNING_KEY is unset)
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES='60'
JWT_REFRESH_DAYS='7'

# API behaviour
API_PAGE_SIZE='20'
THROTTLE_ANON='30/min'
THROTTLE_USER='120/min'

# Local admin account, used by: python manage.py createsuperuser --noinput
DJANGO_SUPERUSER_EMAIL='admin@example.com'
DJANGO_SUPERUSER_NAME='Site Admin'
DJANGO_SUPERUSER_PASSWORD='replace-me'
